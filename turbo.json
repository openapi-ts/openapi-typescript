{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Without this, a cache hit replays the logs and reports success without
      // writing dist/, so anything that consumes this package (its own tests,
      // other packages' tests that shell out to its CLI, attw) fails or reads
      // stale output.
      "outputs": ["dist/**"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.css", "**/biome.json"],
      "dependsOn": ["build"]
    },
    "size-limit": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test-e2e": {
      "dependsOn": ["build"]
    }
  }
}
